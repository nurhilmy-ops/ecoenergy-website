# Terrain screening tool — local settings. run_local.sh / run_local.ps1 copy this to .env
# on first run. Every key maps to a field of app/config.py:Settings (upper-cased); real
# environment variables override this file. Leave a line commented out to keep the default.

# --- core ---
APP_ENV=development
BASE_URL=http://localhost:8000
# SECRET_KEY=            # generated into data/.secret_key in development; required in production
# DATA_DIR=./data        # sqlite database and job files

# --- email ---
# outbox: messages are stored and shown at /dev/outbox (development only).
MAIL_BACKEND=outbox
# MAIL_BACKEND=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025          # 465 = implicit TLS
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false

# --- admin (/admin, HTTP Basic) ---
# Admin pages stay disabled until ADMIN_PASSWORD is set. Pick your own password.
ADMIN_USER=admin
# ADMIN_PASSWORD=

# --- abuse controls ---
# RATE_JOBS_PER_EMAIL_DAY=3
# RATE_JOBS_PER_IP_DAY=10
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- terrain engine ---
# DEM_PROVIDER=copernicus     # copernicus | opentopodata | geotiff
# DEM_GEOTIFF_PATH=           # GeoTIFF or VRT in EPSG:4326, used when DEM_PROVIDER=geotiff

# --- retention (PDPA) ---
# RETENTION_DAYS=30
