# Terrain screening tool settings. run_local.sh / run_local.ps1 copy this file to .env on first
# run. Every key is a field of app/config.py:Settings (upper-cased), shown with its default.
# Real environment variables override this file. A commented-out key keeps its default.
# Put comments on their own line: everything after "=" is read as the value.

# --- core ---
# development or production. Production refuses to start without SECRET_KEY and with MAIL_BACKEND=outbox.
APP_ENV=development
# Public origin used in email links and the Origin check on form posts. Use https:// in production (cookies become Secure).
# Left unset, python -m app uses http://localhost:$PORT, so links follow a changed PORT.
# BASE_URL=http://localhost:8000
# Signing key for unsubscribe links. Empty in development: generated into DATA_DIR/.secret_key. Required in production.
# SECRET_KEY=
# Folder for the SQLite database (app.db) and job files. Relative paths count from where the app is started.
# DATA_DIR=./data
# Take the client IP from X-Forwarded-For. Set true only behind your own reverse proxy, and only if
# that proxy appends the address it received the request from (nginx $proxy_add_x_forwarded_for,
# AWS ALB, Cloudflare) or overwrites the header; never if it passes a client's header on unchanged.
# TRUST_PROXY_HEADERS=false
# How many of your proxies append to X-Forwarded-For (e.g. 2 for Cloudflare in front of nginx).
# The client IP is taken that many hops from the right; the left-most hops can be forged.
# TRUSTED_PROXY_HOPS=1

# --- privacy notice ---
# Version stored with every consent record. Bump it whenever the privacy notice changes.
# NOTICE_VERSION=2026-10-draft-3

# --- email ---
# outbox (development: mail is stored and shown at /dev/outbox), smtp, or ses (Amazon SES API; needs boto3).
MAIL_BACKEND=outbox
# From header of every email.
# MAIL_FROM=EcoEnergy Consultancy <no-reply@ecoconsultancy.services>
# Reply-To header; replies and personal data requests go here.
# MAIL_REPLY_TO=contact@ecoconsultancy.services
# SMTP server when MAIL_BACKEND=smtp (Mailpit in Docker: mailpit).
# SMTP_HOST=localhost
# SMTP port. 465 = implicit TLS; 587 normally with SMTP_STARTTLS=true.
# SMTP_PORT=1025
# SMTP login user; empty = no login.
# SMTP_USER=
# SMTP password.
# SMTP_PASSWORD=
# Upgrade the SMTP connection with STARTTLS (ignored on port 465).
# SMTP_STARTTLS=false
# SES API region when MAIL_BACKEND=ses. SES has no SMTP endpoint in ap-southeast-5 (Malaysia),
# so use the API backend there. AWS credentials come from the standard AWS chain.
# SES_REGION=ap-southeast-5

# --- magic links and sessions ---
# Hours a magic link stays valid.
# TOKEN_TTL_HOURS=72
# How many times one magic link can be used (scanners never use it up: GET /start is read-only).
# TOKEN_MAX_USES=5
# Hours a sign-in session lasts.
# SESSION_TTL_HOURS=24

# --- retention (PDPA) ---
# Days before a site file, its results and reports are deleted (follow-up about that site ends with it).
# RETENTION_DAYS=30
# Days before an email address that was never confirmed is deleted.
# UNVERIFIED_PURGE_DAYS=7
# Days without activity after which a confirmed account with no report left and no newsletter
# subscription is deleted (email, consent records; a one-way hash is kept so it is not contacted).
# INACTIVE_PURGE_DAYS=730

# --- abuse controls ---
# Magic-link requests per email address per hour.
# RATE_LINK_PER_EMAIL_HOUR=3
# Magic-link requests per IP address per hour.
# RATE_LINK_PER_IP_HOUR=10
# Screenings per email address per day.
# RATE_JOBS_PER_EMAIL_DAY=3
# Screenings per IP address per day.
# RATE_JOBS_PER_IP_DAY=10
# Cloudflare Turnstile site key. The human check (and the Cloudflare script on the landing page) is
# on when this is set; sign-ups are refused until TURNSTILE_SECRET_KEY is also set.
# TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key.
# TURNSTILE_SECRET_KEY=

# --- upload limits ---
# Largest KML/KMZ upload, in MB.
# MAX_UPLOAD_MB=5.0
# Largest uncompressed KML inside a KMZ, in MB.
# MAX_KMZ_UNCOMPRESSED_MB=20.0
# Most placemarks (polygons, lines, points) in one file.
# MAX_FEATURES=50
# Largest site extent (bounding-box width or height), in km.
# MAX_EXTENT_KM=15.0

# --- terrain engine ---
# copernicus (reads 1° tiles from AWS by name and byte range; no coordinates sent), opentopodata (fallback; sends site coordinates) or geotiff (local file).
# DEM_PROVIDER=copernicus
# GeoTIFF or VRT in EPSG:4326, used when DEM_PROVIDER=geotiff.
# DEM_GEOTIFF_PATH=
# Base URL of the public Copernicus DEM GLO-30 bucket.
# COPERNICUS_BASE_URL=https://copernicus-dem-30m.s3.amazonaws.com
# OpenTopoData API base URL (DEM_PROVIDER=opentopodata).
# OPENTOPODATA_URL=https://api.opentopodata.org/v1
# OpenTopoData dataset name.
# OPENTOPODATA_DATASET=srtm30m
# Cap on DEM cells analysed per job; larger areas are decimated.
# MAX_GRID_CELLS=400000
# Never draw contours finer than this, in metres.
# CONTOUR_MIN_INTERVAL_M=5.0

# --- worker ---
# Run the job worker as a thread inside the web process (single process). Keep true: with false,
# nothing processes uploads or runs the retention sweeps (only the tests use false).
# WORKER_INLINE=true
# Seconds between queue polls when idle.
# WORKER_POLL_SECONDS=1.0

# --- admin ---
# HTTP Basic user for /admin.
ADMIN_USER=admin
# Password for /admin. Admin pages are disabled (404) while it is empty.
ADMIN_PASSWORD=

# --- links ---
# Target of the "Book a free consult" button (utm tags are added).
# CONSULT_URL=https://www.ecoconsultancy.services/consult/
# Marketing site linked from the header and emails.
# SITE_URL=https://www.ecoconsultancy.services/

# --- process (read by python -m app from the environment or this file, not part of Settings) ---
# Listen address. Use 0.0.0.0 only inside a container or behind a reverse proxy.
# HOST=127.0.0.1
# Listen port.
# PORT=8000
# Log level: DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO
