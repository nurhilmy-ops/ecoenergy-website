# Settings of the EcoEnergy terrain screening tool on this server.
# Created once by setup.sh as /etc/terrain-tool/terrain-tool.env (owner root, readable by the
# app user "terrain" only). Later runs of setup.sh only ADD settings that are missing; they
# never change what is here, so secrets stay the same. After editing: sudo terrain-tool restart
# Format: KEY=value, one per line, no quotes needed; comments on their own line.
# Every setting is explained in terrain-tool/README.md ("Configuration").

# --- core ---
APP_ENV=production
BASE_URL=https://@TOOL_DOMAIN@
# Random signing key, made on this server at install time. Never share it.
SECRET_KEY=@SECRET_KEY@
DATA_DIR=/var/lib/terrain-tool
# Behind Caddy on the same server: Caddy replaces X-Forwarded-For with the visitor's address.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1

# --- process: the app listens only on this server; Caddy serves https:// to the world ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- admin pages (https://@TOOL_DOMAIN@/admin): show with `sudo terrain-tool admin-password` ---
ADMIN_USER=admin
ADMIN_PASSWORD=@ADMIN_PASSWORD@

# --- email: Amazon SES in Asia Pacific (Malaysia), through its HTTPS API ---
MAIL_BACKEND=ses
SES_REGION=ap-southeast-5
MAIL_FROM=EcoEnergy Consultancy <no-reply@ecoconsultancy.services>
MAIL_REPLY_TO=contact@ecoconsultancy.services
# Access keys of the IAM user terrain-tool-ses. Set them with: sudo terrain-tool set-aws-keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- optional: Cloudflare Turnstile human check (see README "Before going live") ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
