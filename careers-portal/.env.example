# Copy to .env (Render: set as environment variables)
PORT=3000
NODE_ENV=production
SESSION_SECRET=change-me-64-random-hex-chars
DATA_DIR=/var/data            # Render persistent disk mount; invites.json + submissions live here
SESSION_TTL_MIN=240
BASE_URL=https://www.ecoconsultancy.services
HR_EMAIL=contact@ecoconsultancy.services
# Optional SMTP notification with PDF attached (Google Workspace: smtp.gmail.com:587 + app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EcoEnergy Careers <contact@ecoconsultancy.services>"
